{
  "name": "onboard-trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:scenarios": "esbuild scripts/check.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-check.mjs --log-level=error && node node_modules/.tmp-check.mjs",
    "test:smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --external:jsdom --outfile=node_modules/.tmp-smoke.cjs --log-level=error && node node_modules/.tmp-smoke.cjs drive && node node_modules/.tmp-smoke.cjs resume"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
